{
  "title": "An enclosure warming up: walls, a fan and a thermostat",
  "about": "A sealed steel enclosure with heat inside (drives and power supplies), in a room. Heat leaves through the walls, about 5.5 W for each square metre and each degree of difference, and the filter fan blows warm air out when the thermostat calls. Its heat capacity is kept small, so it warms in minutes rather than hours: run it at 5×.",
  "dt": 0.05,
  "inputs": {
    "P": {
      "slider": "Heat inside",
      "min": 0,
      "max": 600,
      "step": 10,
      "value": 200,
      "unit": "W"
    },
    "ta": {
      "slider": "Room temperature",
      "min": 0,
      "max": 45,
      "step": 1,
      "value": 25,
      "unit": "°C"
    },
    "mode": {
      "select": "Fan",
      "options": [
        [
          0,
          "Off"
        ],
        [
          1,
          "Thermostat"
        ],
        [
          2,
          "On"
        ]
      ],
      "value": 1
    },
    "tset": {
      "slider": "Thermostat",
      "min": 25,
      "max": 45,
      "step": 1,
      "value": 35,
      "unit": "°C"
    },
    "flow": {
      "slider": "Fan flow",
      "min": 0,
      "max": 300,
      "step": 10,
      "value": 100,
      "unit": "m³/h",
      "hidden": true
    },
    "area": {
      "slider": "Enclosure surface",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "value": 2.4,
      "unit": "m²",
      "hidden": true
    }
  },
  "let": {
    "fan_ok": "1",
    "filter": "1",
    "stat": "1",
    "call": "IF(mode = 2, 1, IF(mode = 0, 0, AND(stat, IF(temp > tset + 1, 1, IF(temp < tset - 1, 0, call)))))",
    "fan": "AND(call, fan_ok)",
    "Gw": "5.5 * area",
    "Ga": "IF(fan, flow * filter / 3, 0)",
    "G": "Gw + Ga",
    "temp": "IF(t = 0, ta, temp + 0.05 * (P - G * (temp - ta)) / 1500)",
    "heading": "ta + P / G",
    "qw": "Gw * (temp - ta)",
    "qa": "Ga * (temp - ta)",
    "spin": "MOD(spin + IF(fan, 13, 0), 360)"
  },
  "faults": {
    "fan-dead": {
      "label": "The fan has failed",
      "set": {
        "fan_ok": "0"
      },
      "why": "The thermostat calls (its lamp is on) but the fan does not turn and no heat goes out with the air: the temperature climbs as though there were no fan. Check the fan's supply at its terminals, then the fan."
    },
    "stat-stuck": {
      "label": "The thermostat never closes",
      "set": {
        "stat": "0"
      },
      "why": "The temperature goes past the thermostat's setting and its lamp never comes on, so the fan is never asked. Switch the fan to On and it runs and cools: the fan is fine, and the fault is the thermostat or its wiring."
    },
    "filter-blocked": {
      "label": "The fan's filter is blocked",
      "set": {
        "filter": "0.2"
      },
      "why": "The thermostat calls and the fan turns, but little air gets through: the heat going out with the air is a fifth of what the fan's rating gives, and the temperature still climbs, only more slowly. Look at the filter mats."
    }
  },
  "script": [
    {
      "at": 0.5,
      "set": {
        "mode": 0
      },
      "say": "Fan off. 200 W inside, 25 °C outside. The walls lose 5.5 W/m²K × 2.4 m² = 13.2 W for every degree inside is above the room, so it heads for 25 + 200 ÷ 13.2 = 40 °C, slowing as it gets there."
    },
    {
      "at": 150,
      "set": {
        "mode": 1
      },
      "say": "Thermostat at 35 °C: the fan starts at 36 °C and stops at 34 °C. With it running, 100 m³/h takes another 33 W/K, so the box cools quickly, and the cycle repeats."
    },
    {
      "at": 260,
      "set": {
        "P": 400
      },
      "say": "Twice the heat: the fan runs for longer each time and the gaps between are shorter."
    }
  ],
  "show": [
    {
      "lamp": "Thermostat calling",
      "on": "call",
      "color": "amber"
    },
    {
      "lamp": "Fan running",
      "on": "fan",
      "color": "green"
    },
    {
      "lamp": "Over 40 °C",
      "on": "temp > 40",
      "color": "red"
    },
    {
      "read": "Inside",
      "value": "temp",
      "unit": "°C",
      "dp": 1
    },
    {
