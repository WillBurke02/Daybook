{
  "title": "A centrifugal pump: suction, discharge and its gauges",
  "about": "An end-suction centrifugal pump on a 5.5 kW, 2-pole motor (2900 rpm, 10.4 A), started direct on line. It draws water from a supply tank 2 m above it (a flooded suction), through a suction valve and a strainer, and pumps it 10 m up to a header tank, through a flow meter, a non-return valve and the discharge valve. PI-1 reads the suction pressure, PI-2 the discharge. The cast arrow on the casing shows which way the shaft should turn. The tanks are drawn much closer than they are, the shaft turns 25 times slower than it does, and the water in the casing warms far faster than in a real pump.",
  "dt": 0.002,
  "inputs": {
    "start": {
      "button": "Start",
      "color": "green"
    },
    "stop": {
      "button": "Stop",
      "nc": 1,
      "color": "red"
    },
    "vent": {
      "button": "Vent the casing"
    },
    "dv": {
      "slider": "Discharge valve",
      "min": 0,
      "max": 100,
      "step": 5,
      "value": 100,
      "unit": "% open"
    },
    "sv": {
      "slider": "Suction valve",
      "min": 0,
      "max": 100,
      "step": 5,
      "value": 100,
      "unit": "% open"
    }
  },
  "let": {
    "strainer": "1",
    "nrv": "1",
    "wear": "0",
    "phase_ok": "1",
    "primed0": "1",
    "primed": "IF(t < 0.01, primed0, IF(vent, 1, primed))",
    "run": "AND(OR(start, run), stop)",
    "dir": "IF(phase_ok, 1, -1)"
  },
  "blocks": {
    "m": {
      "type": "motor",
      "f": 50,
      "on": "run",
      "kw": 5.5,
      "rpm": 2900,
      "poles": 2,
      "Ir": 10.4,
      "J": 0.06,
      "load": "pp.T"
    },
    "pp": {
      "type": "pump",
      "n": "m.n",
      "open": "dv / 100 * nrv",
      "suction": "sv / 100 * strainer",
      "prime": "primed",
      "rev": "1 - phase_ok",
      "wear": "wear"
    }
  },
  "faults": {
    "strainer-blocked": {
      "label": "The suction strainer is badly blocked",
      "set": {
        "strainer": "0.12"
      },
      "why": "It rattles, as if pumping gravel: that is cavitation. PI-1 shows a deep vacuum (about −0.9 bar against +0.2 bar normally), the flow is well down and PI-2 swings about. Too much is lost on the suction side, so the pressure at the impeller's eye falls to the water's vapour pressure and bubbles form and collapse. The suction valve is fully open, so look at the strainer. Cavitation pits an impeller in hours."
    },
    "nrv-stuck": {
      "label": "The non-return valve on the discharge is stuck shut",
      "set": {
        "nrv": "0"
      },
      "why": "No flow at all, yet PI-2 reads the pump's full shut-off pressure (about 4.3 bar) and the motor runs, drawing about half its current. The pump is making pressure against a closed path, the same as a shut discharge valve, but the valve is open. The casing temperature climbs: with no flow, all its power goes into heating the water in it. Shut down before the seal is cooked."
    },
    "worn-impeller": {
      "label": "The impeller is worn",
      "set": {
        "wear": "0.6"
      },
      "why": "Everything is a little down: flow, discharge pressure and current, with a normal suction pressure, no noise and the right rotation. A worn impeller (or a worn wear ring, letting water slip back round) makes less head, so the pump meets the system at a lower flow. Compare PI-2 with the pump's curve at that flow, or with what it read when new."
    },
    "reversed": {
      "label": "It is turning backwards (two supply phases swapped)",
      "set": {
        "phase_ok": "0"
      },
      "why": "The flow and the discharge pressure are about half what they should be, and the current is low, but there is no noise. Look at the coupling: it turns against the cast arrow. A centrifugal pump turning backwards still pumps, but poorly, so it is easily missed. Swap two of the three supply phases at the motor."
    },
    "air-bound": {
      "label": "The casing is full of air (it has lost its prime)",
      "set": {
        "primed0": "0"
      },
      "why": "The motor runs at full speed and light current, but PI-2 hardly moves and there is no flow. An impeller spinning in air cannot make pressure: the head a pump makes is in metres of whatever it is full of, and air weighs about 800 times less than water. Press Vent the casing: the air goes, water fills it, and it pumps. Running dry also burns the mechanical seal."
    }
  },
  "script": [
    {
      "at": 0.5,
      "press": "start",
      "say": "Start: the motor is put straight on to the supply. With the discharge valve open, the pump runs out to about 36 m³/h at 3.2 bar: where its curve meets the system's."
    },
    {
      "at": 5,
      "set": {
        "dv": 50
      },
      "say": "Throttling the discharge valve to half open adds loss to the system: the flow falls, the pressure at PI-2 rises up the pump's curve, and the current falls. A centrifugal pump takes less power at less flow."
    },
    {
      "at": 10,
      "set": {
        "dv": 0
      },
      "say": "Discharge valve shut: no flow, and PI-2 shows the shut-off pressure, the top of the curve. All the power now heats the water in the casing. A few seconds is fine; minutes is not."
    },
    {
      "at": 15,
      "set": {
        "dv": 100
      },
      "say": "Open again: the flow comes back, and the water carries the heat away."
    },
    {
      "at": 20,
      "press": "stop",
      "say": "Stop. The non-return valve shuts as the flow stops, so the header tank does not drain back through the pump."
    }
  ],
  "show": [
    {
      "lamp": "Running",
      "on": "run",
      "color": "green"
    },
    {
      "read": "Flow FT-1",
      "value": "pp.Q",
