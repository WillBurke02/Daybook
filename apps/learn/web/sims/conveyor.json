{
  "title": "A conveyor on a drive, run by a PLC",
  "about": "Start and Stop at the control station seal in the PLC's Running bit. It sends Run to the drive, which ramps the motor up; the gearbox and drum turn the belt. A box arriving at photo-eye PE1 drops Run, so the belt waits until the box is lifted off. A drive trip drops Running.",
  "dt": 0.002,
  "inputs": {
    "start": {
      "button": "Start",
      "color": "green"
    },
    "stop": {
      "button": "Stop",
      "nc": 1,
      "color": "red"
    },
    "reset": {
      "button": "Reset drive",
      "color": "blue"
    },
    "take": {
      "button": "Lift the box off"
    },
    "feed": {
      "switch": "Boxes arriving",
      "value": 1
    },
    "ref": {
      "slider": "Speed reference",
      "min": 5,
      "max": 50,
      "step": 1,
      "value": 50,
      "unit": "Hz"
    },
    "accel": {
      "slider": "Acceleration time",
      "min": 0.05,
      "max": 5,
      "step": 0.05,
      "value": 1.5,
      "unit": "s",
      "hidden": true
    },
    "decel": {
      "slider": "Deceleration time",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 0.5,
      "unit": "s",
      "hidden": true
    },
    "stall": {
      "select": "Stall prevention",
      "options": [
        [
          1,
          "On"
        ],
        [
          0,
          "Off"
        ]
      ],
      "value": 1,
      "hidden": true
    }
  },
  "let": {
    "stop_ok": "1",
    "box_at_eye": "eye.blocked"
  },
  "blocks": {
    "plc": {
      "type": "plc",
      "src": "VAR Running : BOOL; END_VAR\n(* Start and Stop seal in Running; a drive fault drops it out *)\nRunning := (Start OR Running) AND Stop AND NOT Fault;\n(* the belt runs while Running, except while a box waits at the eye *)\nRun := Running AND NOT Eye;\nLamp := Running;",
      "inputs": {
        "Start": "start",
        "Stop": "AND(stop, stop_ok)",
        "Eye": "eye.on",
        "Fault": "vfd.trip"
      },
      "outputs": [
        "Run",
        "Lamp"
      ]
    },
    "vfd": {
      "type": "drive",
      "run": "plc.Run",
      "ref": "ref",
      "reset": "reset",
      "motor": "m1",
      "accel": "accel",
      "decel": "decel",
      "stall": "stall"
    },
    "m1": {
      "type": "motor",
      "f": "vfd.f",
      "on": "vfd.on",
      "kw": 0.75,
      "rpm": 1395,
      "J": 0.004,
      "load": "1.2 + 0.4 * belt.n"
    },
    "belt": {
      "type": "conveyor",
      "rpm": "m1.n",
      "ratio": 20,
      "dia": 0.1,
      "length": 2.4,
      "every": "IF(feed, 3, 0)",
      "size": 0.2,
      "eject": "take",
      "eject_at": 2.0,
      "preload": [
        0.7
      ]
    },
    "eye": {
      "type": "eye",
      "belt": "belt",
      "at": 2.0
    }
  },
  "faults": {
    "eye-stuck-on": {
      "label": "PE1 is stuck on: it says there is a box when there is none",
      "why": "Running is on and the drive is ready, but Run never comes on. PE1's own LED is lit with the beam clear: the PLC sees a box that is not there.",
      "set": {
        "eye.stuck": 1
      }
    },
    "eye-dead": {
      "label": "PE1 is dead: it never sees a box",
      "why": "Boxes run straight past the eye and off the end. PE1's LED never lights, even with a box in the beam: no supply, a dead sensor or a broken signal wire.",
      "set": {
        "eye.stuck": 0
      }
    },
    "stop-wire": {
      "label": "The Stop circuit is open (a broken wire or a loose terminal)",
      "why": "Stop is normally closed so that a broken wire stops the machine rather than leaving it unstoppable. With the circuit open, the PLC's Stop input is 0 and Start cannot seal in: Running flickers on only while Start is held, if at all.",
      "set": {
        "stop_ok": "0"
      }
    },
    "belt-slip": {
      "label": "The belt is slipping on the drive drum",
      "why": "The drive and motor run at full speed and the current is normal, but the boxes creep along at a fraction of the speed they should: the drum turns and the belt does not keep up. Check the belt's tension.",
      "set": {
        "belt.slip": 0.6
      }
    },
    "ramp-too-short": {
      "label": "The drive's acceleration time is far too short (it trips on overcurrent)",
      "why": "Every start, the drive trips (OC) almost at once: the ramp asks for more torque, and so more current, than the motor can give, and stall prevention is off. A longer acceleration time, or current limit on, cures it.",
      "set": {
        "accel": 0.05,
        "stall": 0,
        "m1.J": 0.05
      }
    }
  },
  "script": [
    {
      "at": 0.3,
      "say": "A box is on the belt and more are coming on at the far end. Start is pressed…"
    },
    {
      "at": 1.0,
      "press": "start",
      "say": "Start: the PLC seals in Running and sends Run to the drive, which ramps the motor up over 1.5 s."
    },
    {
      "at": 3.0,
      "say": "The drum turns at about 70 rpm through the 20:1 gearbox; the belt carries the box towards PE1."
    },
    {
      "at": 4.6,
      "say": "The box breaks PE1's beam: Run drops, the drive ramps down in 0.5 s and the box stops at the pick point."
    },
    {
      "at": 8,
      "press": "take",
      "say": "The box is lifted off: the beam is clear, Run comes back on and the belt starts again."
    },
    {
      "at": 13,
      "press": "stop",
      "say": "Stop: Running drops, the drive ramps down, the belt stops. Running stays off until Start is pressed again."
    }
  ],
  "show": [
    {
      "lamp": "Running",
      "on": "plc.Lamp",
      "color": "green"
    },
    {
      "lamp": "Drive fault",
      "on": "vfd.trip",
      "color": "red"
    },
    {
