      "unit": "A",
      "dp": 2
    },
    {
      "read": "Belt",
      "value": "belt.v",
      "unit": "m/s",
      "dp": 2
    },
    {
      "read": "Fault",
      "value": "vfd.fault"
    }
  ],
  "trend": {
