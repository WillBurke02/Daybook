      "dp": 0
    },
    {
      "read": "Air",
      "value": "reg",
      "unit": "bar",
      "dp": 1
    },
    {
      "read": "B's force",
      "value": "force",
      "unit": "kN",
      "dp": 2
    },
    {
      "read": "Good",
      "value": "plc.Good",
      "dp": 0
    },
    {
      "read": "Bad",
      "value": "plc.Bad",
      "dp": 0
    }
  ],
