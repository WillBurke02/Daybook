{
  "title": "A generator: a coil turning in a magnetic field",
  "about": "A square coil turns on a shaft between the poles of a magnet. Its ends come out through two slip rings and brushes to a lamp. As the coil turns, the flux through it rises and falls and an EMF is induced: ε = NABω sin ωt. Set the speed, the turns, the field and the coil's size.",
  "dt": 0.0005,
  "inputs": {
    "rpm": {
      "slider": "Speed",
      "min": 300,
      "max": 3600,
      "step": 60,
      "value": 600,
      "unit": "rpm"
    },
    "N": {
      "slider": "Turns on the coil",
      "min": 10,
      "max": 400,
      "step": 10,
      "value": 100
    },
    "B": {
      "slider": "Field B",
      "min": 0.05,
      "max": 1,
      "step": 0.05,
      "value": 0.3,
      "unit": "T"
    },
    "side": {
      "slider": "Coil side",
      "min": 0.1,
      "max": 0.3,
      "step": 0.01,
      "value": 0.2,
      "unit": "m"
    },
    "load": {
      "switch": "Lamp connected",
      "value": 1
    }
  },
  "let": {
    "brush": "1",
    "magnet": "1",
    "coil": "1",
    "w": "rpm * 2 * PI() / 60",
    "f": "rpm / 60",
    "th": "MOD(th + w * 0.0005, 2 * PI())",
    "peak": "N * coil * B * magnet * side * side * w",
    "emf": "peak * SIN(th)",
    "v_out": "emf * brush",
    "vpk": "MAX(ABS(v_out), vpk * 0.9995)",
    "rms": "peak * brush / SQRT(2)",
    "flux": "B * magnet * side * side * COS(th) * 1000",
    "tc": "IF(t = 0, 20, tc + 0.0005 * (20 + IF(coil < 1, 0.03 * rpm, 0) - tc) / 4)",
    "bright": "AND(load, rms > 3)"
  },
  "faults": {
    "brush-lifted": {
      "label": "A brush has lifted off its slip ring",
      "set": {
        "brush": "0"
      },
      "why": "The coil turns but there is no output at all, at any speed or setting: an open circuit between the coil and the lamp. The brushes and slip rings are the only sliding contacts in the circuit, so look at them first."
    },
    "weak-magnet": {
      "label": "The magnet is weaker than it should be",
      "set": {
        "magnet": "0.6"
      },
      "why": "The output is a clean sine at the right frequency, but its peak is short of NABω by the same fraction (about 0.6) at every speed and every number of turns, and the coil stays cool. Something that scales the flux: a weakened magnet or a bigger air gap."
    },
    "shorted-turns": {
      "label": "Half the coil's turns are shorted together",
      "set": {
        "coil": "0.5"
      },
      "why": "The peak is half of NABω at every speed, and the coil gets hot even with the lamp off: the shorted turns carry a big circulating current of their own. A weak magnet would also lower the voltage, but would not heat the coil."
    },
    "brush-worn": {
      "label": "A brush is worn short: it keeps losing contact",
      "set": {
        "brush": "IF(MOD(t, 0.9) < 0.15, 0, 1)"
      },
      "why": "The output comes and goes: the lamp flickers and the trace drops to zero for a moment, over and over, while the speed, the field and the coil are steady. The EMF is still made in the coil; it is the sliding contact that takes it out that keeps breaking. Replace the brushes, and check the slip rings are clean and round."
    }
  },
  "script": [
    {
      "at": 0.3,
      "say": "600 rpm (10 Hz), 100 turns, 0.3 T, a 0.2 m square coil. The EMF is biggest when the coil's sides cut straight across the field, and zero as it faces the poles: ε₀ = NABω = 100 × 0.3 × 0.04 × 62.8 = 75 V."
    },
    {
      "at": 1.5,
      "set": {
        "rpm": 1200
      },
      "say": "Twice the speed: twice the frequency (20 Hz) and twice the peak, 151 V. Faster cutting, more volts."
    },
    {
      "at": 3,
      "set": {
        "N": 200
      },
      "say": "Twice the turns: twice the voltage again (302 V), at the same frequency."
    },
    {
      "at": 4.5,
      "set": {
        "B": 0.15
      },
      "say": "Half the field: half the voltage (151 V)."
    }
  ],
  "show": [
    {
      "lamp": "Lamp lit",
      "on": "bright",
      "color": "amber"
    },
    {
      "read": "Frequency",
      "value": "f",
      "unit": "Hz",
      "dp": 1
    },
    {
      "read": "Peak voltage (scope)",
      "value": "vpk",
      "unit": "V",
      "dp": 2
    },
    {
      "read": "RMS voltage",
      "value": "rms",
      "unit": "V",
      "dp": 2
    },
    {
      "read": "Flux through one turn",
      "value": "flux",
      "unit": "mWb",
      "dp": 3
    },
    {
      "read": "Coil temperature",
      "value": "tc",
      "unit": "°C",
      "dp": 0
    }
  ],
  "trend": {
