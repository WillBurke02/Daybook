{
  "title": "A ball launcher and a target",
  "about": "A launcher fires a ball at the angle and speed you set, from the ground or from a platform. No air resistance, g = 9.81 m/s². The target is at the distance its slider says; a ball landing within 0.3 m of its centre is a hit.",
  "dt": 0.002,
  "inputs": {
    "ang": {
      "slider": "Angle",
      "min": 5,
      "max": 85,
      "step": 1,
      "value": 45,
      "unit": "°"
    },
    "v": {
      "slider": "Launch speed",
      "min": 2,
      "max": 12,
      "step": 0.5,
      "value": 8,
      "unit": "m/s"
    },
    "fire": {
      "button": "Fire",
      "color": "green"
    },
    "D": {
      "slider": "Target distance",
      "min": 2,
      "max": 15,
      "step": 0.5,
      "value": 6,
      "unit": "m"
    },
    "h": {
      "slider": "Launch height",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "value": 0,
      "unit": "m",
      "hidden": true
    }
  },
  "let": {
    "launch": "AND(fire, NOT(pf))",
    "pf": "fire",
    "vx": "IF(launch, v * COS(RADIANS(ang)), vx)",
    "vy": "IF(launch, v * SIN(RADIANS(ang)), IF(fly, vy - 9.81 * 0.002, 0))",
    "x": "IF(launch, 0, IF(fly, x + vx * 0.002, x))",
    "y": "IF(OR(t = 0, launch), h, IF(fly, y + (vy + 9.81 * 0.001) * 0.002, IF(shots = 0, h, y)))",
    "fly": "IF(launch, 1, IF(AND(fly, y <= 0), 0, fly))",
    "tf": "IF(launch, 0, IF(fly, tf + 0.002, tf))",
    "top": "IF(launch, h, MAX(top, y))",
    "shots": "IF(launch, shots + 1, shots)",
    "hit": "IF(launch, 0, IF(AND(NOT(fly), shots > 0, ABS(x - D) <= 0.3), 1, hit))",
    "yb": "MAX(0, y)"
  },
  "script": [
    {
      "at": 0.5,
      "press": "fire",
      "say": "45°, 8 m/s: it lands v²sin2θ/g = 6.5 m away after 1.15 s, having risen 1.6 m."
    },
    {
      "at": 2.5,
      "set": {
        "ang": 30
      },
      "press": "fire",
      "say": "30°: a flatter, quicker shot to 5.65 m."
    },
    {
      "at": 4.5,
      "set": {
        "ang": 60
      },
      "press": "fire",
      "say": "60°: the same 5.65 m, higher and longer in the air (1.41 s). Angles that add up to 90° give the same range."
    },
    {
      "at": 7,
      "set": {
        "ang": 45,
        "h": 2
      },
      "press": "fire",
      "say": "From 2 m up at 45°: about 8.1 m. It has further to fall, so longer to travel."
    }
  ],
  "show": [
    {
      "lamp": "Hit",
      "on": "hit",
      "color": "green"
    },
    {
      "read": "Distance",
      "value": "x",
      "unit": "m",
      "dp": 2
    },
    {
      "read": "Height",
      "value": "yb",
      "unit": "m",
      "dp": 2
    },
    {
      "read": "Time in the air",
      "value": "tf",
      "unit": "s",
      "dp": 2
    },
    {
      "read": "Highest point",
      "value": "top",
      "unit": "m",
      "dp": 2
    }
  ],
  "trend": {
