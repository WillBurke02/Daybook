{
  "title": "A DOL starter for a fan motor",
  "about": "A direct-on-line starter for a 4 kW fan motor (8.1 A full-load current): Q1 isolates it, contactor K1 switches the motor straight onto the 400 V supply, and overload relay F2 (class 10) trips if the current stays too high. F2's 95–96 contact is in K1's coil circuit and its 97–98 lights H2. There is no PLC: the ladder is the hard-wired control circuit drawn as rungs, with the power flowing live. The fan is drawn turning 25 times slower than it does, and F2 cools faster than a real relay, which can take a minute or more before it will reset.",
  "plc_label": "The control circuit (relays, drawn as a ladder), live",
  "dt": 0.002,
  "inputs": {
    "q1": {
      "switch": "Q1 isolator on",
      "value": 1
    },
    "start": {
      "button": "Start (S1)",
      "color": "green"
    },
    "stop": {
      "button": "Stop (S0)",
      "nc": 1,
      "color": "red"
    },
    "reset": {
      "button": "Reset F2",
      "color": "blue"
    },
    "jam": {
      "switch": "Jam the fan"
    },
    "f2set": {
      "slider": "F2 set current",
      "min": 2,
      "max": 20,
      "step": 0.1,
      "value": 8.1,
      "unit": "A",
      "hidden": true
    }
  },
  "let": {
    "stop_wire": "1",
    "aux_ok": "1",
    "coil_ok": "1",
    "tripped_before": "0",
    "k1_in": "AND(plc.K1, coil_ok)",
    "ipk": "MAX(ipk, m.I)"
  },
  "blocks": {
    "plc": {
      "type": "plc",
      "scan_ms": 1,
      "ladder": [
        {
          "note": "K1's coil: Start or the seal-in (K1 13–14), then Stop, F2 95–96, Q1",
          "logic": "(Start OR K1_Aux) AND Stop_OK AND F2_OK AND Q1_On",
          "out": "K1"
        },
        {
          "note": "H1 Run: lit while K1 is energised",
          "logic": "K1",
          "out": "H1"
        },
        {
          "note": "H2 Tripped: F2 97–98 closes on a trip",
          "logic": "Q1_On AND F2_Trip",
          "out": "H2"
        }
      ],
      "inputs": {
        "Start": "start",
        "Stop_OK": "AND(stop, stop_wire)",
        "F2_OK": "f2.nc",
        "Q1_On": "q1",
        "K1_Aux": "AND(k1_in, aux_ok)",
        "F2_Trip": "f2.no"
      },
      "outputs": [
        "K1",
        "H1",
        "H2"
      ]
    },
    "m": {
      "type": "motor",
      "f": 50,
      "on": "AND(q1, k1_in)",
      "kw": 4,
      "rpm": 1440,
      "poles": 4,
      "Ir": 8.1,
      "lrc": 6,
      "lrt": 2.3,
      "tk": 2.8,
      "J": 0.9,
      "load": "m.Tr * 0.9 * (m.n / 1440)^2 + IF(jam, 3.2 * m.Tr, 0)"
    },
    "f2": {
      "type": "overload",
      "I": "IF(AND(tripped_before, t < 0.01), 10 * f2set, m.I)",
      "set": "f2set",
      "reset": "reset",
      "class": "IF(AND(tripped_before, t < 0.6), 0.01, IF(f2.trip, 1, 10))"
    }
  },
  "faults": {
    "aux-failed": {
      "label": "K1's auxiliary contact (13–14) has failed: it never closes",
      "why": "The fan runs only while Start is held: let go and K1 drops out. In the ladder K1 comes on, but K1_Aux stays 0, so nothing holds K1 in once Start opens. With the supply isolated, check the 13–14 contact block (clipped on? burnt?) and its two wires.",
      "set": {
        "aux_ok": "0"
      }
    },
    "stop-wire": {
      "label": "The Stop circuit is open (a broken wire or a loose terminal)",
      "why": "Nothing happens at all, even with Start held, and no lamp is lit. In the ladder Stop_OK is 0 with nobody pressing Stop: the normally closed stop circuit is broken, which looks exactly like Stop held in. That is why stops are wired normally closed: a broken wire stops the machine. Isolate, then check for continuity through S0's contact and its wires.",
      "set": {
        "stop_wire": "0"
      }
    },
    "f2-tripped": {
      "label": "F2 has tripped and has not been reset",
      "why": "H2 is lit and Start does nothing. In the ladder F2_OK (its 95–96 contact) is 0, so K1's coil circuit is open. Find out why it tripped first (a jam, a tight bearing, a high current), then press Reset. The fan still waits for Start: K1's seal-in dropped out when it tripped.",
      "set": {
        "tripped_before": "1"
      }
    },
    "coil-open": {
      "label": "K1's coil is open circuit (burnt out, or a wire off A1 or A2)",
      "why": "H1 lights while Start is held and the ladder shows K1's rung made, but K1 never pulls in: its carrier does not move, the fan never turns and K1_Aux stays 0. The control circuit is doing its job; the fault is in the contactor. Isolate, then measure the coil's resistance across A1–A2 and check its wires.",
      "set": {
        "coil_ok": "0"
      }
    },
    "f2-too-high": {
      "label": "F2 is set far too high (16 A for an 8.1 A motor)",
      "why": "It starts and runs normally, so nobody notices until the fan jams. Then the motor stalls at about 49 A, its winding heat climbs past 150% and F2 takes nearly a minute to trip. Compare F2's dial with the motor's nameplate: it should be set to the full-load current, 8.1 A.",
      "set": {
        "f2set": 16
      }
    },
    "f2-too-low": {
      "label": "F2 is set too low (5 A for an 8.1 A motor)",
      "why": "It starts and runs normally, then trips after three or four minutes with nothing wrong: F2's heat climbs past 100% while the motor's own heat is still low. The fan draws 7.5 A, well over 5 A. Set F2 to the motor's full-load current, 8.1 A, off the nameplate.",
      "set": {
        "f2set": 5
      }
    },
    "phase-lost": {
      "label": "One supply phase is lost (a blown fuse upstream)",
      "set": {
        "m.phases": 2
      },
      "why": "K1 pulls in, but the fan only hums and does not turn, drawing a high current, and F2 trips. On two phases a three-phase motor has no starting torque. If it had already been running, it would carry on, slower and with about √3 times the current. Check the voltage on all three phases ahead of K1."
    }
  },
  "script": [
    {
      "at": 1,
      "press": "start",
      "say": "Start (S1): K1's coil is energised and K1 pulls in, switching the motor straight onto the 400 V supply. K1's own 13–14 contact closes across Start and seals it in."
    },
    {
      "at": 2,
      "say": "The starting current: with the rotor still, the slip is 100% and the motor draws about 6 × its 8.1 A full-load current, nearly 49 A. It falls as the fan speeds up."
    },
    {
      "at": 6,
      "say": "Running at about 1445 rpm and 7.5 A, near full load: a fan's torque rises with its speed squared. F2 warms slowly with the current."
    },
    {
      "at": 8,
      "set": {
        "jam": 1
      },
      "say": "Jam: the impeller fouls its casing. The motor stalls and draws its locked-rotor current, about 49 A, without a break. F2 and the windings heat up fast."
    },
    {
      "at": 21,
      "say": "F2 trips: its 95–96 contact opens K1's coil circuit, K1 drops out and the motor stops. Its 97–98 contact lights H2."
    },
    {
      "at": 23,
      "set": {
        "jam": 0
      },
      "press": "reset",
      "say": "The jam is cleared. Reset does nothing yet: F2 must cool first (a few seconds here; a real relay can take a minute or more)."
    },
    {
      "at": 29,
      "press": "reset",
      "say": "Reset: 95–96 closes and H2 goes out. Nothing starts by itself: K1's seal-in dropped out when it tripped."
    },
    {
      "at": 31,
      "press": "start",
      "say": "Start again: another surge of starting current, and the fan runs up to speed."
    }
  ],
  "show": [
    {
      "lamp": "H1 Run",
      "on": "plc.H1",
      "color": "green"
    },
    {
      "lamp": "H2 Tripped",
      "on": "plc.H2",
      "color": "amber"
    },
    {
      "read": "Current",
      "value": "m.I",
      "unit": "A",
      "dp": 1
    },
    {
      "read": "Speed",
      "value": "m.n",
      "unit": "rpm",
      "dp": 0
    },
    {
      "meter": "F2 heat",
