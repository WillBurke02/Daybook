    },
    {
      "read": "Fault",
      "value": "IF(ax.trip, \"FE: following error (drive tripped)\", IF(plc.Fault = 1, \"+ limit switch\", IF(plc.Fault = 2, \"− limit switch\", IF(plc.Fault = 3, \"drive tripped\", IF(plc.Fault = 4, \"home switch did not clear\", IF(plc.Fault = 5, \"not homed: Move refused\", \"none\"))))))"
    },
    {
      "read": "Last move took",
      "value": "plc.MoveMs / 1000",
      "unit": "s",
      "dp": 2
    }
  ],
