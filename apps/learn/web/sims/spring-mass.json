{
  "title": "A mass on a spring, with a damper, on a shaker",
  "about": "A mass sits on a coil spring beside a damper (a dashpot). The shaker underneath moves the spring's foot up and down at the amplitude and frequency you set. Pull the mass down and let go to see it ring at its natural frequency; run the shaker to see it follow, resonate, or stay still. The readouts work the natural frequency and the damping ratio out from the settings, and measure what it actually does.",
  "dt": 0.002,
  "inputs": {
    "m": {
      "slider": "Mass",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "value": 2,
      "unit": "kg"
    },
    "k": {
      "slider": "Spring stiffness",
      "min": 300,
      "max": 2000,
      "step": 50,
      "value": 800,
      "unit": "N/m"
    },
    "c": {
      "slider": "Damping",
      "min": 0,
      "max": 120,
      "step": 1,
      "value": 4,
      "unit": "N·s/m"
    },
    "amp": {
      "slider": "Shaker amplitude",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "value": 0,
      "unit": "mm"
    },
    "fd": {
      "slider": "Shaker frequency",
      "min": 0.2,
      "max": 8,
      "step": 0.05,
      "value": 2,
      "unit": "Hz"
    },
    "pull": {
      "button": "Pull down 40 mm and let go",
      "color": "blue"
    }
  },
  "let": {
    "spring": "1",
    "damper": "1",
    "rub": "0",
    "k_eff": "k * spring",
    "c_eff": "c * damper",
    "ph": "MOD(ph + 2 * PI() * fd * 0.002, 2 * PI())",
    "base": "amp / 1000 * SIN(ph)",
    "vb": "amp / 1000 * 2 * PI() * fd * COS(ph)",
    "fnf": "-k_eff * (x - base) - c_eff * (v - vb) - m * 9.81",
    "acc": "(fnf - rub * v / (ABS(v) + 0.0005)) / m",
    "v": "IF(OR(t = 0, pull, AND(ABS(v) < 0.002, ABS(fnf) <= rub)), 0, v + 0.002 * acc)",
    "x": "IF(t = 0, -m * 9.81 / k_eff, IF(pull, -m * 9.81 / k_eff - 0.04, x + 0.002 * v))",
    "rest": "-m * 9.81 / k_eff",
    "pdx": "dx",
    "dx": "(x - rest) * 1000",
    "per": "IF(AND(dx > 0.5, pdx <= 0.5), t - tc, per)",
    "tc": "IF(AND(dx > 0.5, pdx <= 0.5), t, tc)",
    "fm": "IF(per > 0, 1 / per, 0)",
    "ms": "ms + (dx * dx - ms) * 0.002",
    "ax": "SQRT(2 * ms)",
    "fn": "SQRT(k / m) / (2 * PI())",
    "zeta": "c / (2 * SQRT(k * m))",
    "sag": "m * 9.81 / k_eff * 1000"
  },
  "faults": {
    "damper-empty": {
      "label": "The damper has lost its oil",
      "set": {
        "damper": "0.04"
      },
      "why": "Pull it and let go: it rings on for many cycles where the damping ratio from the settings says it should die in a few, and on the shaker at resonance it swings much further. The measured frequency matches the natural frequency and the sag is right, so the spring and mass are as drawn: it is the damping that is missing."
    },
    "spring-soft": {
      "label": "A softer spring than the drawing's is fitted",
      "set": {
        "spring": "0.5"
      },
      "why": "The measured frequency is about 0.7 of the natural frequency worked out from the settings, and the mass sits twice as low (twice the static sag). With the mass as stated, a lower frequency and a bigger sag both mean a softer spring: $k = (2\\pi f)^2 m$ from what you measure gives half the drawing's stiffness."
    },
    "rubbing": {
      "label": "The mass rubs on a guide (dry friction)",
      "set": {
        "rub": "3"
      },
      "why": "Pull it and let go: the swings shrink by the same amount each cycle, so their tops make a straight line on the trend, not the curve viscous damping gives, and it stops dead a little off its rest position. A damper's force grows with speed; dry friction is the same force whatever the speed."
    },
    "damper-seized": {
      "label": "The damper has seized: the damping is enormous",
      "set": {
        "damper": "25"
      },
      "why": "Pulled down and let go, the mass creeps back without overshooting. Shaken at the natural frequency, it just moves with the shaker, by the same amount: there is no resonance peak at all. A seized or over-filled dashpot is nearly a solid link, so the shaking passes straight through. Damping this heavy is far past critical."
    }
  },
  "script": [
    {
      "at": 0.5,
      "press": "pull",
      "for": 1,
      "say": "Pulled down 40 mm and let go: it bounces at its natural frequency, √(k/m)/2π = 3.2 Hz here, and the damper takes a little energy out each cycle (ζ = 0.05)."
    },
    {
      "at": 5,
      "set": {
        "c": 25
      },
      "press": "pull",
      "for": 1,
      "say": "Damping 25 N·s/m, ζ = 0.31: pulled again, the swing dies in a cycle or two."
    },
    {
      "at": 9,
      "set": {
        "c": 4,
        "amp": 2,
        "fd": 1
      },
      "say": "Shaker on: 2 mm at 1 Hz, well below the natural frequency. The mass just follows the shaker."
    },
    {
      "at": 15,
      "set": {
        "fd": 3.2
      },
      "say": "3.2 Hz, at the natural frequency: resonance. With so little damping the swing builds up to about ten times the shaker's."
    },
    {
      "at": 25,
      "set": {
        "fd": 6
      },
      "say": "6 Hz, well above the natural frequency: the mass moves less than half as far as the shaker. Anti-vibration mounts work this way: a natural frequency well below the running speed."
    }
  ],
  "show": [
    {
      "read": "Natural frequency (from the settings)",
      "value": "fn",
      "unit": "Hz",
      "dp": 2
    },
    {
      "read": "Damping ratio ζ (from the settings)",
      "value": "zeta",
      "dp": 3
    },
    {
      "read": "Measured frequency",
      "value": "fm",
      "unit": "Hz",
      "dp": 2
    },
    {
      "read": "Amplitude",
      "value": "ax",
      "unit": "mm",
      "dp": 1
    },
    {
      "read": "Movement from rest",
      "value": "dx",
      "unit": "mm",
      "dp": 1
    },
    {
      "read": "Static sag",
      "value": "sag",
      "unit": "mm",
      "dp": 1
    }
  ],
  "trend": {
    "span": 6,
    "y": [
      -50,
      50
    ],
    "lines": [
      {
        "value": "dx",
        "label": "mass (mm)"
      },
      {
        "value": "base * 1000",
        "label": "shaker (mm)"
      }
    ]
  },
