{
  "title": "A motor on a test bench, on a drive",
  "about": "A 4 kW, 4-pole induction motor (1440 rpm, 8 A) on a drive, run from the drive's keypad. It turns a flywheel (none, small or large) and a load brake on one shaft. Slowing the flywheel makes the motor a generator: the energy comes back to the drive's DC bus, and the brake chopper dumps it in the brake resistor. The bench will not start while the shaft is still turning (it has no flying start): after a trip, the load brake stops a coasting flywheel. The shaft is drawn 25 times slower than it turns, and the motor heats about 20 times faster than a real one, so you can see both.",
  "dt": 0.002,
  "inputs": {
    "run": {
      "button": "Run",
      "color": "green"
    },
    "stop": {
      "button": "Stop",
      "color": "red"
    },
    "reset": {
      "button": "Reset fault",
      "color": "blue"
    },
    "rev": {
      "switch": "Reverse"
    },
    "res": {
      "switch": "Brake resistor connected",
      "value": 1
    },
    "ref": {
      "slider": "Speed reference",
      "min": 0,
      "max": 60,
      "step": 1,
      "value": 50,
      "unit": "Hz"
    },
    "load": {
      "slider": "Load brake",
      "min": 0,
      "max": 150,
      "step": 5,
      "value": 0,
      "unit": "% of rated torque"
    },
    "fly": {
      "select": "Flywheel",
      "options": [
        [
          0,
          "None"
        ],
        [
          1,
          "Small: 0.1 kg·m²"
        ],
        [
          2,
          "Large: 0.5 kg·m²"
        ]
      ],
      "value": 2
    },
    "accel": {
      "slider": "Acceleration time (0 to 60 Hz)",
      "min": 0.2,
      "max": 20,
      "step": 0.1,
      "value": 5,
      "unit": "s",
      "hidden": true
    },
    "decel": {
      "slider": "Deceleration time (60 Hz to 0)",
      "min": 0.2,
      "max": 20,
      "step": 0.1,
      "value": 3,
      "unit": "s",
      "hidden": true
    },
    "stall": {
      "select": "Stall prevention",
      "options": [
        [
          1,
          "On"
        ],
        [
          0,
          "Off"
        ]
      ],
      "value": 1,
      "hidden": true
    }
  },
  "let": {
    "turning": "ABS(m1.n) >= 30",
    "running": "AND(OR(AND(run, NOT(turning)), running), NOT(stop), NOT(vfd.trip))",
    "brake_r": "100",
    "drag": "0",
    "res_w": "IF(AND(vfd.brk, res), vfd.bus ^ 2 / brake_r, 0)",
    "brake_nm": "m1.Tr * (load / 100 + drag)",
    "slip": "IF(ABS(vfd.f) >= 1, m1.slip, 0)",
    "t_run": "IF(running, t, t_run)",
    "t_turn": "IF(OR(running, ABS(m1.n) > 10), t, t_turn)",
    "stop_s": "t_turn - t_run",
    "n_stop": "IF(running, ABS(m1.n), n_stop)"
  },
  "blocks": {
    "vfd": {
      "type": "drive",
      "run": "running",
      "rev": "rev",
      "ref": "ref",
      "reset": "reset",
      "motor": "m1",
      "fmax": 60,
      "accel": "accel",
      "decel": "decel",
      "stall": "stall",
      "brake": "IF(res, brake_r, 0)"
    },
    "m1": {
      "type": "motor",
      "f": "vfd.f",
      "on": "vfd.on",
      "kw": 4,
      "rpm": 1440,
      "poles": 4,
      "J": "0.012 + IF(fly = 1, 0.1, IF(fly = 2, 0.5, 0))",
      "load": "brake_nm",
      "tau": 60
    },
    "chop": {
      "type": "lag",
      "x": "vfd.brk",
      "tau": 0.1
    },
    "pw": {
      "type": "lag",
      "x": "res_w",
      "tau": 0.1
    },
    "rhot": {
      "type": "lag",
      "x": "res_w",
      "tau": 360,
      "gain": 0.8
    }
  },
  "faults": {
    "res-open": {
      "label": "The brake resistor is open circuit (a broken element or a loose wire)",
      "why": "It runs well, but a moment after Stop it trips on OV and the flywheel coasts on. The Brake chopper lamp lights, so the drive is switching the resistor in, but the resistor never glows or warms and the bus carries on up to 800 V: no current flows in it. Isolate, wait for the bus to discharge and prove it dead, then measure the resistor and its wiring with a meter: it should read about 100 Ω. Check its thermal switch too.",
      "set": {
        "brake_r": "1000000"
      }
    },
    "decel-short": {
      "label": "The deceleration time is far too short, with stall prevention off",
      "why": "It runs well, but the moment Stop is pressed it trips on OC, and the flywheel coasts on. The ramp drops the frequency far faster than the flywheel can slow, so the slip, the braking torque and the current shoot up, and with stall prevention off the drive trips rather than easing off. The resistor never gets a chance. Read the deceleration time: here it is 0.5 s. About 3 s suits this flywheel.",
      "set": {
        "decel": 0.5,
        "stall": 0
      }
    },
    "accel-short": {
      "label": "The acceleration time is far too short, with stall prevention off",
      "why": "It trips on OC a fraction of a second after Run, before the flywheel has got going. The ramp asks for far more torque, and so current, than the motor can give, and with stall prevention (the current limit) off the drive trips instead of holding the ramp. Read the acceleration time: lengthen it, or turn stall prevention back on.",
      "set": {
        "accel": 0.2,
        "stall": 0
      }
    },
    "brake-drag": {
      "label": "The load brake is binding: it drags with the load set to 0",
      "why": "No trip, and it reaches 50 Hz, but with the load brake at 0 the motor runs at about 1450 rpm instead of nearly 1500, draws about 7 A instead of 3 A and gives about 21 Nm: the slip, torque and current of a heavy load. The motor heat climbs and the caliper shows clamped. Something is loading the shaft: here the brake. Isolate, check that the caliper releases, and turn the shaft by hand.",
      "set": {
        "drag": "0.8"
      }
    },
    "ilim-low": {
      "label": "The drive's current limit is set far too low",
      "why": "No trip, but it takes about 7 s to reach 50 Hz instead of about 4, with the current flat at about 5 A all the way. Start it with the load brake on and it never gets going. The drive holds its ramp whenever the current is over its limit, and the limit is below what the motor needs. Read the current limit: about 150% of the motor's rated current is usual.",
      "set": {
        "vfd.ilim": 0.6
      }
    }
  },
  "script": [
    {
      "at": 0.3,
      "say": "The bench: a 4 kW motor, the large flywheel (0.5 kg·m²) and a load brake, on a drive set to 50 Hz. Run is pressed…"
    },
    {
      "at": 1.0,
      "press": "run",
      "say": "Run: the drive ramps the frequency up. The motor follows just behind, drawing about 6 A to speed the flywheel up."
    },
    {
      "at": 6.0,
      "say": "At 50 Hz with no load the speed is nearly 1500 rpm: the slip is tiny and the current (about 3 A) is mostly magnetising."
    },
    {
      "at": 8.0,
      "set": {
        "load": 100
      },
      "say": "The load brake goes on, at the rated torque (26.5 Nm): the speed drops to about 1440 rpm, the slip grows to 4%, the current rises to about 8 A."
    },
    {
      "at": 12.0,
      "set": {
        "load": 0
      },
      "say": "The load comes off: back to nearly 1500 rpm and about 3 A."
    },
    {
      "at": 14.0,
      "press": "stop",
      "say": "Stop: the drive ramps down faster than the flywheel would coast. The flywheel drives the motor, the torque and slip go negative: it is a generator."
    },
    {
      "at": 15.0,
      "say": "The energy comes back to the DC bus. It rises from 565 V to 750 V, where the chopper switches the resistor across it: the resistor glows."
    },
    {
      "at": 17.5,
      "say": "Stopped, in under 3 s. The flywheel's energy is now heat in the resistor, and the bus is back to 565 V."
    }
  ],
